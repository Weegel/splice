{
  "id": "campaign_forestwalk",
  "name": "Forestwalk",
  "description": "A quiet forest crossing becomes a dangerous test of courage. Choose the river or the cave, then survive what waits beyond.",
  "difficulty": "Bronze",
  "author": "Splinterlands PvE Studio",
  "isCustom": true,
  "startNodeId": "node_forestwalk_intro",
  "nodes": {
    "node_forestwalk_intro": {
      "id": "node_forestwalk_intro",
      "type": "text",
      "title": "Forestwalk",
      "speakerName": "The Forest Guide",
      "content": "The old trail ends at a split in the woodland. To the east, a river rolls between mossy banks. To the west, a dark cave opens beneath the roots of an ancient tree.",
      "buttonText": "Approach the crossroads",
      "nextNodeId": "node_forestwalk_choice"
    },
    "node_forestwalk_choice": {
      "id": "node_forestwalk_choice",
      "type": "decision",
      "title": "The Crossroads",
      "prompt": "Which route will you take through the forest?",
      "choices": [
        {
          "id": "choice_forestwalk_river",
          "text": "Cross the river",
          "description": "Something large moves beneath the surface.",
          "consequenceSummary": "Battle the giant frog.",
          "nextNodeId": "node_forestwalk_river_battle"
        },
        {
          "id": "choice_forestwalk_cave",
          "text": "Go past the cave",
          "description": "Fresh claw marks score the stone.",
          "consequenceSummary": "Battle the forest bear.",
          "nextNodeId": "node_forestwalk_cave_battle"
        }
      ]
    },
    "node_forestwalk_river_battle": {
      "id": "node_forestwalk_river_battle",
      "type": "battle",
      "title": "Battle: Giant Frog at the River",
      "description": "A giant frog bursts from the river reeds and blocks the crossing.",
      "challengeId": "battle_forestwalk_giant_frog",
      "onVictoryNodeId": "node_forestwalk_river_victory",
      "onDefeatNodeId": "node_forestwalk_defeat",
      "victoryNarrative": "The frog retreats into the reeds, leaving the river crossing open.",
      "defeatNarrative": "The river claims the trail. You retreat into the woods to recover.",
      "rewardCardId": "custom_forestwalk_giant_frog"
    },
    "node_forestwalk_cave_battle": {
      "id": "node_forestwalk_cave_battle",
      "type": "battle",
      "title": "Battle: Bear Beneath the Roots",
      "description": "A massive forest bear emerges from the shadows beside the cave.",
      "challengeId": "battle_forestwalk_bear",
      "onVictoryNodeId": "node_forestwalk_cave_victory",
      "onDefeatNodeId": "node_forestwalk_defeat",
      "victoryNarrative": "The bear withdraws into the cave, and the trail beyond the roots is clear.",
      "defeatNarrative": "The bear drives you away from the cave path.",
      "rewardCardId": "custom_forestwalk_forest_bear"
    },
    "node_forestwalk_river_victory": {
      "id": "node_forestwalk_river_victory",
      "type": "text",
      "title": "Across the Water",
      "content": "You cross the river as evening light breaks through the canopy. The forest trail continues beyond the far bank.",
      "buttonText": "Finish the walk",
      "nextNodeId": "node_forestwalk_success"
    },
    "node_forestwalk_cave_victory": {
      "id": "node_forestwalk_cave_victory",
      "type": "text",
      "title": "Past the Cave",
      "content": "You pass the cave and find a sunlit clearing beyond the roots.",
      "buttonText": "Finish the walk",
      "nextNodeId": "node_forestwalk_success"
    },
    "node_forestwalk_success": {
      "id": "node_forestwalk_success",
      "type": "end",
      "title": "Forestwalk Complete",
      "outcome": "victory",
      "message": "You crossed the forest and reached the far trail. The wilds ahead are only beginning.",
      "rewardSummary": "Forestwalk completed. The defeated guardian is now available during this campaign."
    },
    "node_forestwalk_defeat": {
      "id": "node_forestwalk_defeat",
      "type": "end",
      "title": "The Forest Turns You Back",
      "outcome": "defeat",
      "message": "The forest is too dangerous for your current team. Adjust your lineup and try again."
    }
  },
